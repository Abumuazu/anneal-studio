# Copy to .env.local for local runs; set the same names in Vercel for previews and production.
# Every service is optional: without its variables the matching form reports that it
# could not send, and never claims success.

# Tests and local runs: fake every service in memory (nothing persists).
# INTEGRATIONS=memory

# Booking (Cal.com API v2). The event type is the 30-minute call.
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# Briefs by email (Resend). MAIL_TO defaults to the studio address in content/site.config.ts.
RESEND_API_KEY=
MAIL_FROM="Anneal Studio <briefs@example.com>"
MAIL_TO=

# Briefs and waitlist records (Notion). Share both databases with the integration.
# Briefs database properties: Name (title), Email (email), Offer, Stage, Timing, Heard,
# Currency (select), Budget, Company, Message, Campaign (text), Received (date).
# Waitlist database properties: Email (title), Source (select), Joined (date).
NOTION_TOKEN=
NOTION_BRIEFS_DB=
NOTION_WAITLIST_DB=

# Analytics (Plausible). Leave empty to load no analytics script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Canonical origin for metadata, the sitemap and social images, e.g. https://example.com.
# The domain is still an open item (build-handoff). On Vercel it falls back to the project's
# production URL.
NEXT_PUBLIC_SITE_URL=

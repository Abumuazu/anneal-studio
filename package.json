{
  "name": "anneal-studio",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "node scripts/check-dashes.mjs && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lhci": "pnpm --filter @anneal/site lhci",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "create-site": "node packages/create-studio-site/bin/create-studio-site.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.9"
  }
}
